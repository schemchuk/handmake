# Telegram: live channel (the circle's public channel, bot is its admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram: private test channel (H1); the same bot is its admin.
# Used by the T07 manual check:
#   pnpm --filter @handmake/publisher post:sample
TELEGRAM_TEST_CHANNEL_ID=

# Telegram: operator and bot access (bot worker, later tasks)
OPERATOR_CHAT_ID=
AUTHOR_CHAT_ID=
# Bot Worker allow-list: JSON mapping Telegram user ID -> tenant ID
# (the same bot token is used by the publisher and the Worker)
TELEGRAM_ALLOWED_USER_IDS=
# Random string shared between setWebhook and the Worker (401 on mismatch)
TELEGRAM_WEBHOOK_SECRET=
