# Telegram: live channel (the circle's public channel, bot is its admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram: private test channel (H1); the same bot is its admin.
# Used by the T07 manual check:
#   pnpm --filter @handmake/publisher post:sample
TELEGRAM_TEST_CHANNEL_ID=

# Telegram: operator and bot access (bot worker, later tasks)
OPERATOR_CHAT_ID=
AUTHOR_CHAT_ID=
# Bot Worker allow-list: JSON mapping Telegram user ID -> tenant ID
# (the same bot token is used by the publisher and the Worker)
TELEGRAM_ALLOWED_USER_IDS=
# Random string shared between setWebhook and the Worker (401 on mismatch)
TELEGRAM_WEBHOOK_SECRET=

# Bot Worker: publish dispatch to GitHub Actions (repository_dispatch, H4/H5).
# Fine-grained token: this repo only, "Contents: read and write".
# Stored as a Worker secret:
#   pnpm --filter @handmake/bot exec wrangler secret put GITHUB_DISPATCH_TOKEN
# GITHUB_REPO lives in apps/bot/wrangler.toml [vars] (not a secret).
GITHUB_DISPATCH_TOKEN=

# Publisher -> bot "post is published" callback (T18/T19, H7).
# The publisher signs the callback body with this secret; the Worker verifies
# it (HMAC-SHA256, header X-Handmake-Signature). Same value on both sides:
#   GitHub Secret PUBLISH_CALLBACK_SECRET (used by publish.yml)
#   pnpm --filter @handmake/bot exec wrangler secret put PUBLISH_CALLBACK_SECRET
PUBLISH_CALLBACK_SECRET=
# The bot Worker URL the publisher POSTs the callback to. Not a secret:
#   GitHub repo variable PUBLISH_CALLBACK_URL (used by publish.yml)
# Local runs: set it here to test the callback end to end.
PUBLISH_CALLBACK_URL=
