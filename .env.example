# Telegram: live channel (the circle's public channel, bot is its admin)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram: private test channel (H1); the same bot is its admin.
# Used by the T07 manual check:
#   pnpm --filter @handmake/publisher post:sample
TELEGRAM_TEST_CHANNEL_ID=

# Telegram: operator and bot access (bot worker, later tasks)
OPERATOR_CHAT_ID=
AUTHOR_CHAT_ID=
# Bot Worker allow-list: JSON mapping Telegram user ID -> tenant ID
# (the same bot token is used by the publisher and the Worker)
TELEGRAM_ALLOWED_USER_IDS=
# Random string shared between setWebhook and the Worker (401 on mismatch)
TELEGRAM_WEBHOOK_SECRET=

# Bot Worker: publish dispatch to GitHub Actions (repository_dispatch, H4/H5).
# Fine-grained token: this repo only, "Contents: read and write".
# Stored as a Worker secret:
#   pnpm --filter @handmake/bot exec wrangler secret put GITHUB_DISPATCH_TOKEN
# GITHUB_REPO lives in apps/bot/wrangler.toml [vars] (not a secret).
GITHUB_DISPATCH_TOKEN=

# Publisher -> bot "post is published" callback (T18/T19, H7).
# The publisher signs the callback body with this secret; the Worker verifies
# it (HMAC-SHA256, header X-Handmake-Signature). Same value on both sides:
#   GitHub Secret PUBLISH_CALLBACK_SECRET (used by publish.yml)
#   pnpm --filter @handmake/bot exec wrangler secret put PUBLISH_CALLBACK_SECRET
PUBLISH_CALLBACK_SECRET=
# The bot Worker URL the publisher POSTs the callback to. Not a secret:
#   GitHub repo variable PUBLISH_CALLBACK_URL (used by publish.yml)
# Local runs: set it here to test the callback end to end.
PUBLISH_CALLBACK_URL=

# Dedicated Worker/Node show transport HMAC key. Missing key/binding disables shows.
# Placeholder only: installation and production resources need separate authorization.
SHOW_TRANSPORT_SECRET=
# Node show executor: origin only, never a public media URL.
SHOW_WORKER_ORIGIN=
FAL_KEY=
# Leave closed until exact-model terms and billing are explicitly approved.
SHOW_ALLOW_PAID_CALLS=false
SHOW_VERIFIED_MODELS=[]

# Optional show recovery operators: JSON user-ID to tenant-ID map; denied when empty.
TELEGRAM_SHOW_OPERATOR_IDS={}

# Legal page fields: GitHub Secrets; public only in the generated site, never source.
IMPRESSUM_NAME=
IMPRESSUM_STREET=
IMPRESSUM_CITY=
IMPRESSUM_EMAIL=
# Production deploy requires legal fields; local and CI builds use placeholders.
SITE_REQUIRE_LEGAL=false
# Enable only after Volodymyr AND the author confirm the rendered legal pages.
SITE_INDEXABLE=false

# Meta networks (H8, used by T26a-T26c and T49). GitHub Secrets for publish.yml;
# set here only for local runs. Long-lived tokens only, never short-lived ones.
# App credentials (token exchange and refresh helper, T26a):
META_APP_ID=
META_APP_SECRET=
# Instagram Login API: professional account ID and 60-day token
# (scopes instagram_business_basic, instagram_business_content_publish,
# instagram_business_manage_comments).
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
# Facebook Page: page ID and the non-expiring page token
# (pages_manage_posts, pages_read_engagement, pages_manage_engagement).
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
# Threads API: the Threads app ID (Use cases -> Threads API), user ID and 60-day token
# (threads_basic, threads_content_publish, threads_manage_replies, threads_read_replies).
THREADS_APP_ID=
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# GitHub Actions only: repository Secrets read/write; never a runtime bot secret.
SECRETS_WRITE_TOKEN=

# Threads token rotation: account-limited Workers Scripts: Edit permission.
CLOUDFLARE_WORKERS_TOKEN=

# Shared Worker/publisher HMAC key for private contest names (H9).
NAMES_ENDPOINT_SECRET=

# Publisher: private show-media reads through the Cloudflare R2 API.
# In GitHub this is the separate CLOUDFLARE_R2_READ_TOKEN secret (R2 read only),
# mapped to CLOUDFLARE_API_TOKEN for the publish step; never expose it to clients.
CLOUDFLARE_R2_READ_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
