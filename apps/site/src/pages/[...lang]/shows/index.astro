---
import Base from '../../../layouts/Base.astro';
import ShowFeed from '../../../components/ShowFeed.astro';
import { loadSiteData } from '../../../lib/site-data';
import { showsIn } from '../../../lib/shows';
import { langParam, pagePath } from '../../../lib/paths';
import { uiStrings } from '../../../lib/i18n';
export async function getStaticPaths() {
  const { tenant, site } = await loadSiteData();
  return tenant.languages.map((lang) => ({ params: { lang: langParam(lang, site.defaultLanguage) }, props: { lang } }));
}
const { lang } = Astro.props;
const data = await loadSiteData();
const ui = uiStrings(lang);
const shows = showsIn(data, lang);
const alternates = Object.fromEntries(data.tenant.languages.map((code) => [code, pagePath(code, data.site.defaultLanguage, 'shows')]));
---
<Base lang={lang} title={ui.showsHeading} alternates={alternates} current="shows">
  <section class="wrap page">
    <h1>{ui.showsHeading}</h1>
    {shows.length ? <ShowFeed shows={shows} lang={lang} data={data} /> : <p class="empty">{ui.noShows}</p>}
  </section>
</Base>
