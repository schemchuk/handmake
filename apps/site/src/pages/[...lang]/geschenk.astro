---
import Base from '../../layouts/Base.astro';
import { loadSiteData } from '../../lib/site-data';
import { langParam, pagePath } from '../../lib/paths';
import { newsletterStrings } from '../../lib/newsletter';
export async function getStaticPaths() {
  const { site, tenant } = await loadSiteData();
  return site.newsletter ? tenant.languages.map((lang) => ({
    params: { lang: langParam(lang, site.defaultLanguage) }, props: { lang },
  })) : [];
}
const { lang } = Astro.props;
const { site, tenant } = await loadSiteData();
const text = newsletterStrings(lang);
const alternates = Object.fromEntries(tenant.languages.map((code) => [code, pagePath(code, site.defaultLanguage, 'geschenk')]));
---
<Base lang={lang} title={text.gift} alternates={alternates}>
  <article class="wrap page">
    <h1>{text.gift}</h1>
    <p><a href="/geschenk/rosenbluete.pdf" download>{text.download}</a></p>
  </article>
</Base>
