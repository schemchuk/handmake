---
import Base from '../../layouts/Base.astro';
import { langParam, pagePath } from '../../lib/paths';
import { loadSiteData } from '../../lib/site-data';
export async function getStaticPaths() {
  const { tenant, site } = await loadSiteData();
  return tenant.languages.map((lang) => ({ params: { lang: langParam(lang, site.defaultLanguage) }, props: { lang } }));
}
const { lang } = Astro.props;
const { tenant, site } = await loadSiteData();
const alternates = Object.fromEntries(tenant.languages.map((code) => [code, pagePath(code, site.defaultLanguage, '404')]));
---
<Base lang={lang} title="404" alternates={alternates}>
  <div class="wrap page page--reading"><h1>404</h1><p>{lang === 'uk' ? 'Сторінку не знайдено.' : 'Seite nicht gefunden.'}</p><a href={pagePath(lang, site.defaultLanguage)}>{lang === 'uk' ? 'На головну' : 'Zur Startseite'}</a></div>
</Base>
