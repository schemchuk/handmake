---
import Base from '../../layouts/Base.astro';
import Stitch from '../../components/Stitch.astro';
import { uiStrings } from '../../lib/i18n';
import { langParam, pagePath, presentationPath } from '../../lib/paths';
import { formatMeeting } from '../../lib/schedule';
import { loadSiteData } from '../../lib/site-data';
import { excerpt, paragraphs } from '../../lib/text';

export async function getStaticPaths() {
  const { tenant, site } = await loadSiteData();
  if (!site.circle) return [];
  return tenant.languages.map((lang) => ({
    params: { lang: langParam(lang, site.defaultLanguage) },
    props: { lang },
  }));
}

const { lang } = Astro.props;
const data = await loadSiteData();
const def = data.site.defaultLanguage;
const ui = uiStrings(lang);
const circle = data.site.circle!;
const texts = circle.texts[lang]!;
const groupUrl = data.site.groupUrl;
const presentation = presentationPath(lang);
const alternates = Object.fromEntries(
  data.tenant.languages.map((code) => [code, pagePath(code, def, 'kreis')]),
);
---

<Base lang={lang} title={texts.title} description={excerpt(texts.what)} alternates={alternates} current="circle">
  <div class="wrap page">
    <div class="page-body">
      <h1>{texts.title}</h1>
      {paragraphs(texts.what).map((paragraph) => <p class="lead">{paragraph}</p>)}
      <dl class="facts">
        <dt>{ui.when}</dt>
        <dd>{formatMeeting(data.tenant.meetingSchedule, lang)}</dd>
        <dt>{ui.where}</dt>
        <dd>{texts.where}</dd>
      </dl>
      <a class="button" href={circle.joinUrl} rel="noopener">{ui.join}</a>
      {presentation && (
        <p>
          <a class="button" href={presentation} type="application/pdf">{ui.presentation}</a>
        </p>
      )}
      {groupUrl && (
        <section class="group" aria-labelledby="group-heading">
          <Stitch />
          <h2 id="group-heading">{ui.groupHeading}</h2>
          <p>{ui.groupText}</p>
          <a class="button" href={groupUrl} rel="noopener">{ui.joinGroup}</a>
        </section>
      )}
    </div>
  </div>
</Base>
