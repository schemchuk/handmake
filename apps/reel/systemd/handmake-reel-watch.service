[Unit]
Description=Faden und Stimmung reel folder watcher
StartLimitIntervalSec=0

[Service]
WorkingDirectory=%h/VS_Code_projects/handmake
ExecStart=/usr/bin/node apps/reel/src/watch.ts %h/Desktop/temp/videos
Restart=on-failure
RestartSec=10
Nice=10
CPUQuota=400%
MemoryMax=3G
KillMode=mixed
TimeoutStopSec=infinity

[Install]
WantedBy=default.target
